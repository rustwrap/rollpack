{
  "name": "rollpack",
  "version": "1.0.0",
  "description": "A webpack-compatible Node API and CLI backed by the Rolldown bundler (Rust/Oxc) for fast builds and excellent tree-shaking. Drop-in `webpack` override for pcf-scripts and webpack-based pipelines.",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/run.js"
  },
  "bin": {
    "webpack": "bin/rollpack.js",
    "rollpack": "bin/rollpack.js"
  },
  "files": [
    "lib/",
    "bin/",
    "README.md"
  ],
  "dependencies": {
    "acorn": "^8.17.0",
    "eslint-scope": "^9.1.2",
    "loader-runner": "^4.3.2",
    "mime-types": "^3.0.2",
    "postcss": "^8.5.16",
    "postcss-modules": "^6.0.1",
    "rolldown": "^1.1.3",
    "schema-utils": "^4.3.3",
    "tapable": "^2.3.3",
    "terser-webpack-plugin": "^5.6.1",
    "webpack-sources": "^3.5.0"
  },
  "keywords": [
    "webpack",
    "rolldown",
    "bundler",
    "pcf",
    "tree-shaking"
  ],
  "license": "MIT"
}
